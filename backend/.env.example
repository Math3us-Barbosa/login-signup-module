POSTGRES_DB=login_signup_module
POSTGRES_USER=login_signup_module
POSTGRES_PASSWORD=change-me

DB_URL=jdbc:postgresql://localhost:5432/login_signup_module
DB_USERNAME=login_signup_module
DB_PASSWORD=change-me

# HS256 exige uma chave de no minimo 256 bits (32 caracteres); gere a sua com, por exemplo,
# `openssl rand -base64 32`
JWT_SECRET=change-me-change-me-change-me-32chars
